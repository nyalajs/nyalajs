{
    "name": "@nyalajs/storage",
    "version": "1.1.0",
    "description": "Storage abstraction for NyalaJS",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@nyalajs/core": "*",
        "fs-extra": "^11.2.0"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "^3.0.0",
        "@aws-sdk/lib-storage": "^3.0.0",
        "@aws-sdk/s3-request-presigner": "^3.0.0",
        "reflect-metadata": ">=0.1.13"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-s3": {
            "optional": true
        },
        "@aws-sdk/lib-storage": {
            "optional": true
        },
        "@aws-sdk/s3-request-presigner": {
            "optional": true
        }
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.0.0",
        "@aws-sdk/lib-storage": "^3.0.0",
        "@types/fs-extra": "^11.0.4",
        "typescript": "^5.3.3",
        "vitest": "^1.0.4"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    }
}
