{
    "name": "@nyalajs/queue",
    "version": "1.0.0",
    "description": "BullMQ-backed job queue for NyalaJS",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "test": "vitest run"
    },
    "dependencies": {
        "@nyalajs/core": "*"
    },
    "peerDependencies": {
        "bullmq": "^5.1.0",
        "reflect-metadata": ">=0.1.13"
    },
    "peerDependenciesMeta": {
        "bullmq": {
            "optional": true
        }
    },
    "devDependencies": {
        "typescript": "^5.3.3",
        "vitest": "^1.0.4"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    }
}
