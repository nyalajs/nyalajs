{
    "name": "@nyalajs/database",
    "version": "2.1.0",
    "description": "Drizzle-backed ORM for NyalaJS",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "test": "vitest run"
    },
    "dependencies": {
        "@nyalajs/core": "*",
        "drizzle-orm": "^0.45.2"
    },
    "peerDependencies": {
        "pg": "^8.11.3",
        "postgres": "^3.4.3",
        "mysql2": "^3.9.1",
        "better-sqlite3": "^9.4.0",
        "reflect-metadata": ">=0.1.13"
    },
    "peerDependenciesMeta": {
        "pg": {
            "optional": true
        },
        "postgres": {
            "optional": true
        },
        "mysql2": {
            "optional": true
        },
        "better-sqlite3": {
            "optional": true
        }
    },
    "devDependencies": {
        "typescript": "^5.3.3",
        "vitest": "^1.0.4",
        "better-sqlite3": "^9.4.0",
        "mysql2": "^3.9.1",
        "pg": "^8.11.3",
        "@types/better-sqlite3": "^7.6.8",
        "@types/pg": "^8.11.0"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    }
}
