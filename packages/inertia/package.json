{
    "name": "@nyalajs/inertia",
    "version": "1.0.0",
    "description": "Inertia.js server adapter for NyalaJS — controllers return page components with props, no separate REST/GraphQL API",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "default": "./dist/client/index.js"
        },
        "./ssr": {
            "types": "./dist/ssr/index.d.ts",
            "default": "./dist/ssr/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "dev": "tsc --watch"
    },
    "dependencies": {
        "@nyalajs/core": "*",
        "@nyalajs/http": "*"
    },
    "devDependencies": {
        "@inertiajs/core": "2.3.27",
        "@inertiajs/react": "2.3.27",
        "@types/node": "^20.10.6",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "typescript": "^5.3.3",
        "vitest": "^1.0.4"
    },
    "peerDependencies": {
        "@inertiajs/core": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "react": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
        "reflect-metadata": ">=0.1.13"
    },
    "peerDependenciesMeta": {
        "@inertiajs/react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    }
}
