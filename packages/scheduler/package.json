{
    "name": "@nyalajs/scheduler",
    "version": "1.0.0",
    "description": "Cron-based scheduler for NyalaJS",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
