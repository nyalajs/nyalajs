{
    "name": "@nyalajs/mail",
    "version": "1.0.1",
    "description": "Nodemailer-backed mail system for NyalaJS",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@nyalajs/core": "*",
        "nodemailer": "^6.9.9"
    },
    "devDependencies": {
        "@types/nodemailer": "^6.4.14",
        "typescript": "^5.3.3",
        "vitest": "^1.0.4"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "reflect-metadata": ">=0.1.13"
    }
