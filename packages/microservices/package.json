{
    "name": "@nyalajs/microservices",
    "version": "1.1.0",
    "description": "Message-pattern microservice transports (TCP, Redis, gRPC, NATS, Kafka) for NyalaJS",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc && npm run copy-assets",
        "copy-assets": "mkdir -p dist/transports/grpc && cp src/transports/grpc/nyala-rpc.proto dist/transports/grpc/nyala-rpc.proto",
        "clean": "rm -rf dist",
        "test": "vitest run"
    },
    "dependencies": {
        "@nyalajs/core": "*",
        "zod": "^3.22.4"
    },
    "peerDependencies": {
        "@grpc/grpc-js": "^1.9.0",
        "@grpc/proto-loader": "^0.7.10",
        "ioredis": "^5.3.2",
        "kafkajs": "^2.2.4",
        "nats": "^2.19.0",
        "reflect-metadata": ">=0.1.13"
    },
    "peerDependenciesMeta": {
        "@grpc/grpc-js": {
            "optional": true
        },
        "@grpc/proto-loader": {
            "optional": true
        },
        "ioredis": {
            "optional": true
        },
        "kafkajs": {
            "optional": true
        },
        "nats": {
            "optional": true
        }
    },
    "devDependencies": {
        "@grpc/grpc-js": "^1.9.0",
        "@grpc/proto-loader": "^0.7.10",
        "ioredis": "^5.3.2",
        "kafkajs": "^2.2.4",
        "nats": "^2.19.0",
        "typescript": "^5.3.3",
        "vitest": "^1.0.4"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    }
}
