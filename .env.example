# Env vars for developing the Nyala monorepo itself (framework packages'
# test suites, `docker compose up`). Not for a scaffolded application —
# that gets its own .env.example (e.g. templates/saas-starter/.env.example)
# with its own, more complete set of variables.

# Driver integration tests (packages/database) skip themselves unless these
# are set. `docker compose up -d` starts matching local Postgres/MySQL.
POSTGRES_TEST_URL=postgres://postgres@127.0.0.1:5432/nyala_test
MYSQL_TEST_URL=mysql://root@127.0.0.1:3306/nyala_test

# packages/queue's dashboard e2e test (dashboard.e2e.spec.ts) skips itself
# unless this is set, pointed at a real local Redis.
QUEUE_TEST_REDIS_URL=redis://127.0.0.1:6379

# packages/storage's S3/R2 disk tests skip themselves unless these are set,
# pointed at a local S3-compatible service (e.g. MinIO).
S3_TEST_ENDPOINT=http://127.0.0.1:9100
R2_TEST_ENDPOINT=http://127.0.0.1:9110

# Used by packages/http's session support when exercised directly (most
# framework package tests don't need these — an application built with
# Nyala sets its own, see that app's .env.example).
SESSION_SECRET=
SESSION_SALT=

# Used by packages/http's rate-limit Redis store when exercised directly.
REDIS_URL=
