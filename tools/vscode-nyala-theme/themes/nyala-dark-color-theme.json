    },
    "tokenColors": [
        {
            "settings": {
                "foreground": "#d7e4de"
            }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {
                "foreground": "#4d6259",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": {
                "foreground": "#b6c64a"
            }
        },
        {
            "scope": ["constant.numeric", "constant.language", "constant.character"],
            "settings": {
                "foreground": "#ffe066"
            }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
            "settings": {
                "foreground": "#f6cb24"
            }
        },
        {
            "scope": ["entity.name.function", "support.function", "meta.function-call"],
            "settings": {
                "foreground": "#3ee6b8"
            }
        },
        {
            "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
            "settings": {
                "foreground": "#01b19d",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": {
                "foreground": "#14e242"
            }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": {
                "foreground": "#f6cb24"
            }
        },
        {
            "scope": ["variable", "variable.other.readwrite", "variable.parameter"],
            "settings": {
                "foreground": "#c3d4cc"
            }
        },
        {
            "scope": ["variable.other.constant", "variable.other.property"],
            "settings": {
                "foreground": "#7fe6c4"
            }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": {
                "foreground": "#7c9389"
            }
        },
        {
            "scope": ["keyword.operator"],
            "settings": {
                "foreground": "#d4a91a"
            }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#f36868"
            }
        },
        {
            "scope": ["markup.bold"],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["markup.italic"],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["markup.heading"],
            "settings": {
                "foreground": "#f6cb24",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["markup.inline.raw", "markup.raw"],
            "settings": {
                "foreground": "#b6c64a"
            }
        }
    ]
}
