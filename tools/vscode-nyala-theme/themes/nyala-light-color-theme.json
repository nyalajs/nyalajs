        "peekViewEditor.background": "#f5f4ec",
        "peekViewResult.background": "#fbfaf6",
        "peekView.border": "#00532f"
    },
    "tokenColors": [
        {
            "settings": {
                "foreground": "#1a2b25"
            }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {
                "foreground": "#8a988f",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": {
                "foreground": "#3f7d0f"
            }
        },
        {
            "scope": ["constant.numeric", "constant.language", "constant.character"],
            "settings": {
                "foreground": "#9c6f00"
            }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
            "settings": {
                "foreground": "#8a6a00"
            }
        },
        {
            "scope": ["entity.name.function", "support.function", "meta.function-call"],
            "settings": {
                "foreground": "#00785f"
            }
        },
        {
            "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
            "settings": {
                "foreground": "#003d22",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": {
                "foreground": "#00532f"
            }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": {
                "foreground": "#a3760a"
            }
        },
        {
            "scope": ["variable", "variable.other.readwrite", "variable.parameter"],
            "settings": {
                "foreground": "#33453e"
            }
        },
        {
            "scope": ["variable.other.constant", "variable.other.property"],
            "settings": {
                "foreground": "#0f6e52"
            }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": {
                "foreground": "#6b7d74"
            }
        },
        {
            "scope": ["keyword.operator"],
            "settings": {
                "foreground": "#a3760a"
            }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#c3423f"
            }
        },
        {
            "scope": ["markup.bold"],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["markup.italic"],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["markup.heading"],
            "settings": {
                "foreground": "#003d22",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["markup.inline.raw", "markup.raw"],
            "settings": {
                "foreground": "#00785f"
            }
        }
    ]
}
