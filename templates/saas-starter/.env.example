# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT Configuration — use two DIFFERENT secrets. A refresh token signed
# with the same secret as an access token could otherwise be presented
# to an access-token-only endpoint and verify successfully.
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-secure-random-string-in-production
# Days only (e.g. "7d") — AuthService parses this to compute the stored
# refresh-token row's expiry, kept in sync with the JWT's own exp claim.
JWT_REFRESH_EXPIRES_IN=7d

# Database — real Postgres required (this starter has no other supported
# driver). `docker compose up -d postgres` starts a real local instance
# matching these defaults; see docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nyala_saas

# Connection pool + TLS tuning (all optional — sane defaults apply if unset).
# DB_POOL_MAX should stay well under your Postgres server's max_connections
# divided by how many app instances you run.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
# TLS is enabled automatically when NODE_ENV=production (most managed
# Postgres providers require it). Set DATABASE_SSL=false to disable it for a
# self-hosted DB without TLS; set DB_SSL_REJECT_UNAUTHORIZED=true (with a
# trusted CA configured) to fully verify the server certificate instead of
# just encrypting the connection.
# DATABASE_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Multi-Tenancy
TENANT_RESOLUTION_STRATEGY=subdomain
TENANT_REQUIRED=true

# Observability
LOG_LEVEL=info
SERVICE_NAME=saas-app

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# CORS
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Application URL — used to build links in emails (verification, password
# reset, team invites) and payment checkout redirect/webhook URLs. Set this
# to your real deployed URL in production.
APP_URL=http://localhost:3000

# Mail — leave MAIL_HOST unset in development and the app falls back to
# nodemailer's Ethereal test inbox automatically (a real "sent" email you
# can view in a browser, logged to the console on send — nothing real is
# delivered). Set these for a real SMTP provider in production.
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
MAIL_FROM_NAME="Your App"
MAIL_FROM_ADDRESS=noreply@example.com

# Payments — Stripe is wired by default (see bootstrap/app.module.ts's
# PaymentService provider). The app boots fine with no key set at all (a
# placeholder is used), but checkout/billing will fail with a clear
# "Invalid API Key" error until you set a real one. Get test keys from
# https://dashboard.stripe.com/test/apikeys — six other gateways (Chapa,
# Paystack, Flutterwave, Mollie, Razorpay, Xendit) are a config change away,
# see @nyalajs/payments' README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_DEFAULT_GATEWAY=stripe
