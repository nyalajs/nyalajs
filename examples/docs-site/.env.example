# Application
NODE_ENV=development
APP_NAME="Nyala Docs"
APP_URL=http://localhost:3000
APP_DEBUG=true
APP_TIMEZONE=UTC

# Server
HOST=0.0.0.0
PORT=3000
BODY_LIMIT=1048576
REQUEST_TIMEOUT=30000

# Docs source — where the real website/docs/*.md files live. Defaults to
# ../../website/docs (this app's real location two levels under the repo
# root); override if you deploy this app from a different checkout layout.
DOCS_SOURCE_DIR=

# Inertia / Vite
VITE_BUILD_OUT_DIR=public/build
VITE_DEV_SERVER_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
