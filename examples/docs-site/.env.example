# Application
NODE_ENV=development
APP_NAME="Nyala Docs"
APP_URL=http://localhost:3000
APP_DEBUG=true
APP_TIMEZONE=UTC

# Server
HOST=0.0.0.0
PORT=3000
BODY_LIMIT=1048576
REQUEST_TIMEOUT=30000

# Database — MySQL (see config/database.ts and database/connection.ts).
# Docs content is stored here (see app/models/doc.model.ts); `npm run
# db:seed` fills it from the real website/docs/*.md files.
DB_DRIVER=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nyaladocs
# Set this instead of the DB_* vars above to use a full connection URI.
DATABASE_URL=

# Sessions — required (@fastify/secure-session, see bootstrap/main.ts).
# CSRF protection for the create/update/delete doc forms needs this.
# SESSION_SECRET must be at least 32 chars; SESSION_SALT exactly 16.
SESSION_SECRET=change-this-to-a-random-32-character-or-longer-string
SESSION_SALT=change-this-16ch

# Admin login — gates doc create/update/delete (see app/guards/admin.guard.ts,
# app/controllers/auth.controller.ts). Empty by default, so a fresh clone's
# admin login always fails closed instead of accepting an empty password.
# bcrypt hash of your chosen password, NOT the plaintext password itself.
# Generate one with:
#   node -e "require('bcrypt').hash('yourpassword', 10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Inertia / Vite
VITE_BUILD_OUT_DIR=public/build
VITE_DEV_SERVER_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
